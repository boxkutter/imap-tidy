# mail-translate environment. On Unraid: paste into the stack's "Edit ENV" box.
# Wrap every password/key in SINGLE quotes: compose would otherwise treat
# `$` as a variable and ` #` as a comment, silently changing the value.

# --- IMAP passwords (names must match $${NAME} in the compose config block) ---
PASS_PERSONAL='change-me'
#PASS_WORK='change-me'

# --- Translator: fill in the one you chose with `provider:` ---
# DeepL (provider: deepl). Free tier key ends in :fx. Pro: DEEPL_URL='https://api.deepl.com/v2/translate'
DEEPL_API_KEY=''
#DEEPL_URL='https://api-free.deepl.com/v2/translate'

# LibreTranslate (provider: libretranslate)
#LT_URL='http://libretranslate:5000'
#LT_API_KEY=''

# OpenAI-compatible endpoint (provider: llm), e.g. Ollama on the Unraid host:
#LLM_URL='http://192.168.1.10:11434/v1'
#LLM_MODEL='qwen2.5:7b'
#LLM_API_KEY=''

# --- Optional ---
LOG_LEVEL=INFO
#PUID=99          # owner of files in appdata (Unraid default nobody:users)
#PGID=100
